# MiniNCE 环境配置示例
# 复制此文件为 .env 并修改实际配置

# 应用配置
APP_NAME=MiniNCE
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./minince.db

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/minince.log

# 加密配置
# Fernet 密钥，使用 cryptography 生成:
# from cryptography.fernet import Fernet
# key = Fernet.generate_key()
# print(key.decode())
ENCRYPTION_KEY=your-encryption-key-here

# SSH 默认配置
SSH_TIMEOUT=30
SSH_PORT=22
