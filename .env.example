# MiniNCE 环境配置示例
# 复制此文件为 .env 并修改实际配置
# 或使用 start.bat 自动生成安全配置

# 环境标识：development / testing / production
# production 启动时会强制校验安全配置（加密密钥、Debug、Host）
ENVIRONMENT=production

# 应用配置
APP_NAME=MiniNCE
APP_VERSION=0.1.0

# 安全默认值：关闭 Debug，仅监听本地回环
# 生产环境禁止修改为 true / 0.0.0.0
DEBUG=false
HOST=127.0.0.1
PORT=8000

# 数据库配置
DATABASE_URL=sqlite:///./minince.db

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=logs/minince.log

# 加密配置（必须配置，生产环境启动会校验）
# 生成新密钥：
#   py -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 或使用 start.bat 自动生成
ENCRYPTION_KEY=your-encryption-key-here

# SSH 默认配置
SSH_TIMEOUT=30
SSH_PORT=22
